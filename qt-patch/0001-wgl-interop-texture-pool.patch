+static bool isSameTextureDesc(const D3D11_TEXTURE2D_DESC &a, const D3D11_TEXTURE2D_DESC &b)
+{
+    return a.Width == b.Width && a.Height == b.Height && a.MipLevels == b.MipLevels
+            && a.ArraySize == b.ArraySize && a.Format == b.Format
+            && a.SampleDesc.Count == b.SampleDesc.Count
+            && a.SampleDesc.Quality == b.SampleDesc.Quality;
+}
+
+// Free textures kept per OpenGL context. A frame is usually replaced before the next one is
+// imported, so two or three textures cover the steady state.
+static constexpr qsizetype MaxFreeTexturesPerContext = 4;
+
+WGLHelper::InteropTexture *WGLHelper::acquireTexture(const D3D11_TEXTURE2D_DESC &desc)
+{
+    QOpenGLContext *context = QOpenGLContext::currentContext();
+    Q_ASSERT(context);
+
+    QList<InteropTexture *> staleTextures;
+    {
+        QMutexLocker locker(&m_poolMutex);
+        for (qsizetype i = 0; i < m_freeTextures.size(); ++i) {
+            InteropTexture *texture = m_freeTextures.at(i);
+            if (texture->context == context && isSameTextureDesc(texture->desc, desc)) {
+                m_freeTextures.removeAt(i);
+                m_usedTextures.append(texture);
+                return texture;
+            }
+        }
+
+        // The remaining free textures of this context have an outdated size or format.
+        for (auto it = m_freeTextures.begin(); it != m_freeTextures.end();) {
+            if ((*it)->context == context) {
+                staleTextures.append(*it);
+                it = m_freeTextures.erase(it);
+            } else {
+                ++it;
+            }
+        }
+    }
+    for (InteropTexture *texture : std::as_const(staleTextures))
+        destroyTexture(texture, /*deleteGLTexture=*/true);
+
+    auto *texture = new InteropTexture;
+    texture->desc = desc;
+    texture->context = context;
+    texture->surface = context->surface();
+
+    HRESULT hr = m_device->CreateTexture2D(&desc, nullptr, &texture->d3dTexture);
+    if (FAILED(hr)) {
+        qWarning("WGL: Failed to create D3D11 texture: %ls",
+                 qUtf16Printable(QSystemError::windowsComString(hr)));
+        delete texture;
+        return nullptr;
+    }
+
+    auto *glFun = context->functions();
+    glFun->glGenTextures(1, &texture->glTexture);
+
+    // Bind the DXGI texture to a GL texture.
+    texture->glHandle = m_functions->wglDXRegisterObjectNV(m_interopDevice,
+                                                           texture->d3dTexture.Get(),
+                                                           texture->glTexture, GL_TEXTURE_2D,
+                                                           WGL_ACCESS_READ_ONLY_NV);
+    Q_ASSERT(glFun->glGetError() == GL_NO_ERROR);
+    if (!texture->glHandle || texture->glHandle == INVALID_HANDLE_VALUE) {
+        qWarning("WGL: Failed to register D3D11 texture: %ls",
+                 qUtf16Printable(QSystemError::windowsString()));
+        glFun->glDeleteTextures(1, &texture->glTexture);
+        delete texture;
+        return nullptr;
+    }
+
+    QMutexLocker locker(&m_poolMutex);
+    if (!m_watchedContexts.contains(context)) {
+        m_watchedContexts.insert(context);
+        QObject::connect(
+                context, &QOpenGLContext::aboutToBeDestroyed, context,
+                [this, context]() { contextAboutToBeDestroyed(context); }, Qt::DirectConnection);
+    }
+    m_usedTextures.append(texture);
+    return texture;
+}
+
+void WGLHelper::releaseTexture(InteropTexture *texture)
+{
+    bool keep = false;
+    {
+        QMutexLocker locker(&m_poolMutex);
+        m_usedTextures.removeOne(texture);
+        if (texture->context) {
+            const auto freeCount = std::count_if(
+                    m_freeTextures.cbegin(), m_freeTextures.cend(),
+                    [texture](InteropTexture *t) { return t->context == texture->context; });
+            if (freeCount < MaxFreeTexturesPerContext) {
+                m_freeTextures.append(texture);
+                keep = true;
+            }
+        }
+    }
+    if (!keep)
+        destroyTexture(texture, /*deleteGLTexture=*/texture->context != nullptr);
+}
+
+void WGLHelper::destroyTexture(InteropTexture *texture, bool deleteGLTexture)
+{
+    if (texture->glHandle && texture->glHandle != INVALID_HANDLE_VALUE)
+        m_functions->wglDXUnregisterObjectNV(m_interopDevice, texture->glHandle);
+
+    if (deleteGLTexture && texture->glTexture && texture->context) {
+        QOpenGLContext *createContext = texture->context;
+        QOpenGLContext *currentContext = QOpenGLContext::currentContext();
+        QSurface *currentSurface = nullptr;
+        bool canDelete = true;
+
+        if (createContext != currentContext) {
+            if (currentContext)
+                currentSurface = currentContext->surface();
+
+            if (!createContext->makeCurrent(texture->surface)) {
+                qWarning("Failed to make OpenGL context current for clean-up, OpenGL resources "
+                         "will not be destroyed.");
+                canDelete = false;
+            }
+        }
+
+        if (canDelete && createContext->isValid())
+            createContext->functions()->glDeleteTextures(1, &texture->glTexture);
+
+        if (currentSurface) {
+            if (!currentContext->makeCurrent(currentSurface))
+                qFatal("Failed to restore OpenGL context after clean-up.");
+        }
+    }
+
+    delete texture;
+}
+
+void WGLHelper::contextAboutToBeDestroyed(QOpenGLContext *context)
+{
+    QList<InteropTexture *> freeTextures;
+    {
+        QMutexLocker locker(&m_poolMutex);
+        m_watchedContexts.remove(context);
+        for (auto it = m_freeTextures.begin(); it != m_freeTextures.end();) {
+            if ((*it)->context == context) {
+                freeTextures.append(*it);
+                it = m_freeTextures.erase(it);
+            } else {
+                ++it;
+            }
+        }
+        // Textures still in use are destroyed without the context when they are released.
+        for (InteropTexture *texture : std::as_const(m_usedTextures)) {
+            if (texture->context == context) {
+                texture->context = nullptr;
+                texture->surface = nullptr;
+            }
+        }
+    }
+
+    // The surface may already be gone, so only delete GL textures if the context is current.
+    const bool isCurrent = QOpenGLContext::currentContext() == context;
+    for (InteropTexture *texture : std::as_const(freeTextures)) {
+        if (!isCurrent) {
+            texture->context = nullptr;
+            texture->surface = nullptr;
+        }
+        destroyTexture(texture, isCurrent);
+    }
+}
